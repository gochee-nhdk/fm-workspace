# Set default behavior, that all text files will have LF line endings in repository
* text=auto eol=lf

# Windows batch scripts must keep CRLF to execute properly
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Shell scripts must always use LF line endings
*.sh text eol=lf

# Code and text files use standard LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.env* text eol=lf
