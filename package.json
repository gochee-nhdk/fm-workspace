{
  "name": "procurement-assistant",
  "version": "1.0.0",
  "author": "Farmers Market Vietnam",
  "license": "UNLICENSED",
  "private": true,
  "description": "FM Workspace - Personal Work OS & Procurement Assistant (Vercel Serverless + Turso)",
  "main": "api/index.js",
  "scripts": {
    "setup": "npm install && npm --prefix client install --legacy-peer-deps && npm run build",
    "install:all": "npm install && npm --prefix client install --legacy-peer-deps",
    "dev": "npm --prefix client run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix client test"
  },
  "devDependencies": {
    "@vercel/node": "^28.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/analytics": "^2.0.1",
    "nodemailer": "^10.2.1",
    "zod": "^3.24.2"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
