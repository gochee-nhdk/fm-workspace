    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/@liqui-design/glass/dist/glass.css';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');c=c.replace('@layer base {','').replace(/}\\s*\\n\\s*\\n\\.liqui-glass--elevated/,'\\n.liqui-glass--elevated');fs.writeFileSync(p,c);}\"",
