# ==============================================================================
# FM WORKSPACE - ROOT ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file or configure server/.env and client/.env directly.

# ------------------------------------------------------------------------------
# Backend Server (server/.env or Render Dashboard Environment Variables)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# In production on Render, DO NOT set HOST=127.0.0.1; leave empty so it binds to 0.0.0.0
HOST=127.0.0.1

# Hosted Database (Turso Cloud Free Tier)
# For Zero-Cost Cloud Deployment: Configure TURSO_DATABASE_URL and TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite Storage (Used for Desktop / Local Offline development)
DATA_DIR=./data
DATABASE_PATH=./data/procurement.db

# JWT Secret (REQUIRED in production: Must be cryptographically secure random string >= 32 chars)
JWT_SECRET=change_this_to_a_random_32_character_string_for_production

# CORS: URL of Frontend Client on Vercel
CLIENT_URL=https://fm-workspace.vercel.app
ALLOWED_ORIGINS=https://fm-workspace.vercel.app

# Initial Admin Credentials (Optional; if omitted in production, random password is generated once on DB init)
INITIAL_ADMIN_EMAIL=admin@farmersmarket.vn
INITIAL_ADMIN_PASSWORD=

# Optional Integrations
GEMINI_API_KEY=
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ------------------------------------------------------------------------------
# Frontend Client (client/.env or Vercel Environment Variables)
# ------------------------------------------------------------------------------
# URL of Backend API (Render web service URL). Do not include trailing /api.
VITE_API_URL=https://farmers-market-procurement-api.onrender.com
