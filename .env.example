# ==============================================================================
# FM WORKSPACE - ENVIRONMENT TEMPLATE (Vercel Serverless + Turso Cloud)
# ==============================================================================
# Configure these variables in Vercel Project Settings -> Environment Variables
# or in a local .env file for local development (never commit .env!).

# ------------------------------------------------------------------------------
# Database (Turso Cloud Free Tier - @libsql/client)
# ------------------------------------------------------------------------------
# Required in production on Vercel; falls back to local file only in local dev
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Security & Encryption (REQUIRED in production)
# ------------------------------------------------------------------------------
# Cryptographically secure random string (>= 32 chars) for signing JWTs
JWT_SECRET=change_this_to_a_random_32_character_string_for_production
# Cryptographically secure 32-byte key (64 hex chars or >= 32 chars) for AES-256-GCM secret encryption
ENCRYPTION_KEY=change_this_to_a_random_32_character_encryption_key

# ------------------------------------------------------------------------------
# CORS & Origins
# ------------------------------------------------------------------------------
CLIENT_URL=https://fm-workspace.vercel.app
ALLOWED_ORIGINS=https://fm-workspace.vercel.app

# ------------------------------------------------------------------------------
# Initial Admin Credentials (Optional)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@farmersmarket.vn
INITIAL_ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# AI & Email Integrations (Optional)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# Frontend Client (Optional — leave empty for same-origin /api on Vercel)
# ------------------------------------------------------------------------------
VITE_API_URL=
