# ============================================
# FM Workspace - Server Environment Variables
# ============================================

PORT=3000
NODE_ENV=development
HOST=127.0.0.1

# SQLite Database Location (Mặc định tự tạo thư mục data/ nếu chưa có)
DATABASE_PATH=./data/procurement.db

# JWT Secret (Chuỗi ngẫu nhiên bảo mật dùng để ký token)
JWT_SECRET=fm_procurement_enterprise_jwt_super_secret_key_2026

# Google Gemini API Key (Có thể cấu hình tại đây hoặc nhập trực tiếp trên giao diện Settings)
GEMINI_API_KEY=

# URL của Frontend Client (dùng cho CORS Whitelist)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000
