# ==============================================================================
# FM Workspace - Server Environment Variables
# ==============================================================================

PORT=3000
NODE_ENV=development
# In production on Render, DO NOT set HOST=127.0.0.1; leave empty so it binds to 0.0.0.0
HOST=127.0.0.1

# Hosted Database (Turso Cloud Free Tier)
# Provide these when deploying to Render Free to use durable cloud storage:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local SQLite Storage (Used for Desktop / Local Offline development)
DATA_DIR=./data
DATABASE_PATH=./data/procurement.db

# JWT Secret (REQUIRED in production: Must be cryptographically secure random string >= 32 chars)
JWT_SECRET=fm_procurement_enterprise_jwt_super_secret_key_2026_at_least_32_chars

# URL của Frontend Client (dùng cho CORS Whitelist)
CLIENT_URL=https://fm-workspace.vercel.app
ALLOWED_ORIGINS=https://fm-workspace.vercel.app

# Initial Admin Credentials
INITIAL_ADMIN_EMAIL=admin@farmersmarket.vn
INITIAL_ADMIN_PASSWORD=

# Google Gemini API Key (Có thể cấu hình tại đây hoặc nhập trực tiếp trên giao diện Settings)
GEMINI_API_KEY=

# SMTP Mailer (Tùy chọn)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000
