{
  "name": "ai-procurement-server",
  "version": "1.0.0",
  "description": "AI Procurement & Merchandising Assistant Backend",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --clean",
    "start": "node dist/index.js",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "tsx src/__tests__/calculations.test.ts && tsx src/__tests__/e2e-workflow.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.1",
    "@google/genai": "^0.3.1",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "fastify": "^4.26.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "nodemailer": "^10.0.10",
    "papaparse": "^5.4.1",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.24",
    "@types/nodemailer": "^8.0.2",
    "@types/papaparse": "^5.3.14",
    "@types/uuid": "^9.0.8",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
